# ==============================================================================
# AdaptiveArticulate Server Deployment Configurations
# Rename this file to .env and configure before running scripts/setup-server.sh
# ==============================================================================

# Public domain name or IP address of the server
SERVER_NAME=example.com

# Target directory where the application code will be located on the host
APP_DIR=/var/www/adaptive-articulate

# Whisper model to pre-download (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Flask environment configuration
FLASK_ENV=production
SECRET_KEY=change-me-to-a-secure-random-string-12345

# Server routing port and Gunicorn process settings
PORT=5000
WORKERS=3

# Production database URL (leave empty/uncommented to use default SQLite database)
# DATABASE_URL=postgresql://articulate_user:secure_db_pass_998@localhost:5432/adaptive_articulate
